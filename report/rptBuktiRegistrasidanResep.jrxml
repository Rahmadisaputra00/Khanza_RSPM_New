	<parameter name="norawat" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    reg_periksa.no_reg,
    reg_periksa.no_rawat,
    reg_periksa.tgl_registrasi,
    reg_periksa.jam_reg,
    pasien.no_tlp,
    pasien.no_ktp,
    reg_periksa.kd_dokter,
    dokter.nm_dokter,
    reg_periksa.no_rkm_medis,
    pasien.nm_pasien,
    pasien.jk,
    pasien.tgl_lahir,
    pasien.umur,
    pasien.no_peserta,
    poliklinik.nm_poli,
    reg_periksa.p_jawab,
    reg_periksa.almt_pj,
    reg_periksa.hubunganpj,
    reg_periksa.biaya_reg,
    reg_periksa.stts_daftar,
    penjab.png_jawab
FROM 
    reg_periksa
INNER JOIN 
    dokter ON reg_periksa.kd_dokter = dokter.kd_dokter
INNER JOIN 
    pasien ON reg_periksa.no_rkm_medis = pasien.no_rkm_medis
INNER JOIN 
    poliklinik ON reg_periksa.kd_poli = poliklinik.kd_poli
INNER JOIN 
    penjab ON reg_periksa.kd_pj = penjab.kd_pj
WHERE 
    reg_periksa.no_rawat = $P{norawat};]]>
	</queryString>
