	<queryString>
		<![CDATA[select 
    surat_cuti_hamil.no_surat, 
    surat_cuti_hamil.no_rawat, 
    reg_periksa.no_rkm_medis, 
    pasien.nm_pasien, 
    DATE_FORMAT(pasien.tgl_lahir, '%d-%m-%Y') as tgl_lahir, 
    dokter.nm_dokter, 
    pasien.jk, 
    pasien.pekerjaan, 
    reg_periksa.tgl_registrasi, 
    surat_cuti_hamil.keterangan_hamil, 
    surat_cuti_hamil.terhitung_mulai, 
    surat_cuti_hamil.perkiraan_lahir, 
    concat(pasien.alamat, ', ', kelurahan.nm_kel, ', ', kecamatan.nm_kec, ', ', kabupaten.nm_kab) as alamat 
from 
    surat_cuti_hamil 
inner join 
    reg_periksa on surat_cuti_hamil.no_rawat = reg_periksa.no_rawat 
inner join 
    pasien on reg_periksa.no_rkm_medis = pasien.no_rkm_medis 
inner join 
    dokter on dokter.kd_dokter = reg_periksa.kd_dokter 
where 
    reg_periksa.no_rawat = '" + TNoRw.getText() + "']]>
	</queryString>
